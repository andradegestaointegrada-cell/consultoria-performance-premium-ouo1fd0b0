---
// Layout de todas as páginas: SEO (título, descrição, canônico, Open Graph, JSON-LD),
// tema sem piscar, fontes locais, cabeçalho, rodapé e botão do WhatsApp.
import '@fontsource-variable/inter'
import '@fontsource-variable/playfair-display'
import '@fontsource-variable/playfair-display/wght-italic.css'
import '@/styles/main.css'
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import playfairLatin from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url'
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import WhatsAppButton from '@/components/WhatsAppButton.astro'
import { ALEXANDRE, ORGANIZACAO, ORG_ID, SITE_NOME, SITE_URL, WHATSAPP_MSG_PADRAO } from '@/data/site'

interface Props {
  title: string
  description: string
  /** Imagem da prévia de compartilhamento (recortada em 1200×630). */
  image?: ImageMetadata
  imageAlt?: string
  type?: 'website' | 'article'
  /** Trilha a partir da home, sem incluir a home. */
  breadcrumbs?: { name: string; path: string }[]
  /** Nós extras do JSON-LD (Service, BlogPosting, Person...). */
  jsonLd?: Record<string, unknown>[]
  pageType?: string
  whatsapp?: string
  overHero?: boolean
  noindex?: boolean
  preloadImage?: string
  publishedTime?: Date
  modifiedTime?: Date
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  breadcrumbs = [],
  jsonLd = [],
  pageType = 'WebPage',
  whatsapp = WHATSAPP_MSG_PADRAO,
  overHero = false,
  noindex = false,
  preloadImage,
  publishedTime,
  modifiedTime,
} = Astro.props

// Com build.format 'file' a home chega como /index ou /index.html.
const pathname =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/\/+$/, '') || '/'
const canonical = pathname === '/' ? `${SITE_URL}/` : `${SITE_URL}${pathname}`

let ogImage = { url: `${SITE_URL}/og-image.png`, width: 1024, height: 1024 }
if (image) {
  const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', quality: 80 })
  ogImage = { url: new URL(og.src, SITE_URL).href, width: 1200, height: 630 }
}

const trilha = breadcrumbs.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#trilha`,
      itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: b.path === '/' ? `${SITE_URL}/` : `${SITE_URL}${b.path}`,
      })),
    }
  : null

const grafo = {
  '@context': 'https://schema.org',
  '@graph': [
    ORGANIZACAO,
    ALEXANDRE,
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#site`,
      url: `${SITE_URL}/`,
      name: SITE_NOME,
      inLanguage: 'pt-BR',
      publisher: { '@id': ORG_ID },
    },
    {
      '@type': pageType,
      '@id': `${canonical}#pagina`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${SITE_URL}/#site` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage.url },
      ...(trilha ? { breadcrumb: { '@id': trilha['@id'] } } : {}),
    },
    ...(trilha ? [trilha] : []),
    ...jsonLd,
  ],
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content="Andrade Gestão Integrada e Treinamento" />
    <meta name="google-site-verification" content="snUjeQays4q6CPfG_da6N64PRAY3f1MfNTJFhfVUKGg" />
    <meta name="theme-color" content="#091D39" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NOME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={playfairLatin} as="font" type="font/woff2" crossorigin />
    {/* Inter sem preload: a banda inicial fica com a fonte dos títulos e a foto do hero. */}
    {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}

    <!-- Tema antes da primeira pintura: mesma chave "theme" usada pelo site anterior. -->
    <script is:inline>
      ;(function () {
        var raiz = document.documentElement
        var midia = matchMedia('(prefers-color-scheme: dark)')
        function lerTema() {
          try {
            return localStorage.getItem('theme') || 'system'
          } catch (e) {
            return 'system'
          }
        }
        function aplicar() {
          var t = lerTema()
          var escuro = t === 'dark' || (t === 'system' && midia.matches)
          raiz.classList.toggle('dark', escuro)
          raiz.style.colorScheme = escuro ? 'dark' : 'light'
        }
        aplicar()
        midia.addEventListener('change', function () {
          if (lerTema() === 'system') aplicar()
        })
      })()
    </script>
    <noscript><style>[data-reveal]{opacity:1!important}</style></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(grafo)} />
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground focus:font-bold"
    >
      Pular para o conteúdo
    </a>
    <div
      class="flex flex-col min-h-screen font-sans bg-background text-foreground antialiased selection:bg-primary selection:text-white"
    >
      <Header overHero={overHero} pathname={pathname} />
      <main id="conteudo" class="flex-grow">
        <slot />
      </main>
      <Footer />
      <WhatsAppButton mensagem={whatsapp} />
    </div>

    <script is:inline>
      ;(function () {
        // Cabeçalho: fundo de vidro depois de 20 px de rolagem.
        var h = document.getElementById('site-header')
        function topo() {
          h.toggleAttribute('data-top', window.scrollY <= 20)
        }
        topo()
        addEventListener('scroll', topo, { passive: true })

        // Revelação ao rolar.
        var els = document.querySelectorAll('[data-reveal]')
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach(function (el) {
            el.classList.remove('opacity-0')
          })
          return
        }
        var io = new IntersectionObserver(
          function (entradas) {
            entradas.forEach(function (e) {
              if (!e.isIntersecting) return
              io.unobserve(e.target)
              var atraso = Number(e.target.getAttribute('data-reveal-delay')) || 0
              setTimeout(function () {
                e.target.classList.add('animate-fade-in-up')
              }, atraso)
            })
          },
          { threshold: 0.1, rootMargin: '50px' },
        )
        els.forEach(function (el) {
          io.observe(el)
        })
      })()
    </script>
  </body>
</html>
