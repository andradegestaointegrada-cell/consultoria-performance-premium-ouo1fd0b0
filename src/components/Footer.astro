---
import { Image } from 'astro:assets'
import { Linkedin, Facebook, Mail, Phone } from 'lucide-react'
import { EMAIL_CONTATO, WHATSAPP, WHATSAPP_URL } from '@/lib/api'
import { NewsletterSignup } from '@/components/NewsletterSignup'
import logoLight from '@/assets/logo-fundo-branco-7d1af.webp'
import logoDark from '@/assets/logo-fundo-azul-petroleo-29887.webp'

const [usuarioEmail, dominioEmail] = EMAIL_CONTATO.split('@')
const ano = new Date().getFullYear()
const linkClass = 'hover:text-primary transition-colors duration-300'
---

<footer class="bg-background border-t border-border pt-20 pb-10">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] gap-12 mb-16">
      <div class="md:col-span-1">
        <a href="/" class="flex flex-col justify-center mb-6 group">
          <div class="flex items-center gap-3">
            <Image
              src={logoLight}
              width={252}
              alt="Andrade Gestão Integrada"
              class="h-14 w-auto dark:hidden group-hover:opacity-80 transition-opacity"
            />
            <Image
              src={logoDark}
              width={252}
              alt="Andrade Gestão Integrada"
              class="h-14 w-auto hidden dark:block rounded-md overflow-hidden group-hover:opacity-80 transition-opacity"
            />
          </div>
          <span
            class="text-xs text-muted-foreground uppercase tracking-widest font-bold font-heading mt-2 opacity-80 group-hover:opacity-100 transition-opacity"
          >
            Estratégia, Conformidade e Performance
          </span>
        </a>
        <p class="text-muted-foreground text-sm mb-6 leading-relaxed">
          Estruturamos sistemas de gestão que alinham estratégia organizacional, garantem
          conformidade normativa e impulsionam a performance das empresas.
        </p>
        <div class="mb-8">
          <p class="text-sm font-bold text-foreground uppercase tracking-wider mb-2">Sede Operacional</p>
          <address class="not-italic text-sm text-muted-foreground leading-relaxed">
            Rua Pais Leme, 215, conj. 1713
            <br />
            Pinheiros, São Paulo/SP · <span class="whitespace-nowrap">CEP 05424-150</span>
          </address>
          <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
            <li>
              <a
                href={`mailto:${EMAIL_CONTATO}`}
                class="inline-flex items-start gap-2 hover:text-primary transition-colors"
              >
                <Mail className="h-4 w-4 shrink-0 text-primary mt-0.5" />
                <span class="[overflow-wrap:anywhere]">
                  {usuarioEmail}@<wbr />{dominioEmail}
                </span>
              </a>
            </li>
            <li>
              <a
                href={WHATSAPP_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 hover:text-primary transition-colors"
              >
                <Phone className="h-4 w-4 shrink-0 text-primary" />
                {WHATSAPP}
              </a>
            </li>
          </ul>
        </div>
        <div class="flex gap-4">
          <a
            href="https://www.linkedin.com/company/andrade-gest%C3%A3o-integrada-treinamento/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Página da AGI no LinkedIn"
            class="p-2 rounded-full border border-border text-muted-foreground hover:text-primary hover:border-primary transition-all duration-300"
          >
            <Linkedin className="h-5 w-5" />
          </a>
          <a
            href="https://www.facebook.com/profile.php?id=100077658203124"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Página da AGI no Facebook"
            class="p-2 rounded-full border border-border text-muted-foreground hover:text-primary hover:border-primary transition-all duration-300"
          >
            <Facebook className="h-5 w-5" />
          </a>
        </div>
      </div>

      <div>
        <h2 class="font-heading font-bold text-xl text-foreground mb-6 uppercase tracking-wide">
          Navegação
        </h2>
        <ul class="space-y-4 text-sm font-bold text-muted-foreground uppercase tracking-wider">
          <li><a href="/sobre" class={linkClass}>Sobre Nós</a></li>
          <li><a href="/servicos" class={linkClass}>Serviços</a></li>
          <li><a href="/tecnologia" class={linkClass}>Tecnologia</a></li>
          <li><a href="/metodologia" class={linkClass}>Metodologia</a></li>
          <li><a href="/cases" class={linkClass}>Cases de Sucesso</a></li>
          <li><a href="/insights" class={linkClass}>Blog Técnico</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-heading font-bold text-xl text-foreground mb-6 uppercase tracking-wide">
          Legal
        </h2>
        <ul class="space-y-4 text-sm font-bold text-muted-foreground uppercase tracking-wider">
          <li><a href="/termos-de-uso" class={linkClass}>Termos de Uso</a></li>
          <li><a href="/politica-de-privacidade" class={linkClass}>Política de Privacidade</a></li>
          <li><a href="/portal-lgpd" class={linkClass}>Portal de LGPD</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-heading font-bold text-xl text-foreground mb-6 uppercase tracking-wide">
          Newsletter
        </h2>
        <p class="text-sm text-muted-foreground mb-6">
          Conteúdo quinzenal sobre sistemas de gestão, normas ISO e conformidade.
        </p>
        <NewsletterSignup client:visible origem="rodape" id="footer-newsletter" />
      </div>
    </div>

    <div
      class="border-t border-border pt-8 text-center text-sm font-bold text-muted-foreground uppercase tracking-wider flex flex-col md:flex-row justify-between items-center"
    >
      <p>
        © {ano} Andrade Gestão Integrada e Treinamento · CNPJ 66.060.174/0001-58
      </p>
      <p class="mt-4 md:mt-0">
        Atuação integrada:{' '}
        <a
          href="https://www.cyberconsulting.com.br/?utm_source=agi&utm_medium=site&utm_campaign=integracao"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[hsl(var(--ouro-texto))] hover:underline underline-offset-4"
        >
          Cyber Consulting
        </a>
      </p>
      <p class="mt-4 md:mt-0 text-primary">Desenvolvido com precisão.</p>
    </div>
  </div>
</footer>
