---
import { Image } from 'astro:assets'
import { ArrowRight, ChevronDown } from 'lucide-react'
import Reveal from '@/components/Reveal.astro'
import Button from '@/components/Button.astro'
import Malha from '@/components/tech/Malha.astro'
import bgImage from '@/assets/home/home-hero.webp'
---

<!-- min-h (e não h fixa): em telas baixas o hero cresce e nada fica cortado. -->
<section class="relative min-h-[100svh] flex items-center pt-32 pb-24 lg:pb-28 overflow-hidden group">
  <div class="absolute inset-0 z-0 bg-black">
    <Image
      src={bgImage}
      alt=""
      widths={[640, 960, 1280, 1536]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-[center_30%] md:object-center opacity-70 grayscale contrast-125 transition-opacity duration-700"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0D0D0D]/95 via-[#0D0D0D]/70 to-[#091D39]/60"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent"></div>
    <div class="absolute inset-0 grade-tech"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_70%_28%,rgba(9,29,57,0.8),transparent_70%)] lg:bg-[radial-gradient(ellipse_38%_55%_at_74%_52%,rgba(9,29,57,0.85),transparent_72%)]"
    >
    </div>
  </div>

  <!-- Camada tecnológica: o símbolo da AGI em malha, envolto pela rede das normas da Cyber. -->
  <div
    class="pointer-events-none absolute z-[1] top-16 h-[46%] left-[22%] -right-[18%] opacity-60 sm:left-[35%] sm:-right-[8%] lg:opacity-100 lg:inset-y-0 lg:top-12 lg:h-auto lg:left-auto lg:right-0 lg:w-[50%] xl:right-[2%] xl:w-[48%]"
  >
    <Malha forma="logo" />
  </div>

  <div class="container relative z-10 mx-auto px-4">
    <div class="max-w-3xl lg:max-w-[50%]">
      <Reveal>
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-primary/30 text-primary text-sm font-bold mb-6 uppercase tracking-wider"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping motion-reduce:animate-none absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          Consultoria em sistemas de gestão
        </div>
      </Reveal>

      <Reveal delay={100}>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-heading font-bold tracking-tight text-white mb-6 leading-[1.08] uppercase break-words"
        >
          Estratégia, Conformidade e{' '}
          <em class="font-heading italic text-primary font-normal">Performance</em>.
        </h1>
      </Reveal>

      <Reveal delay={200}>
        <p class="text-lg sm:text-xl text-white/85 mb-8 max-w-2xl leading-relaxed font-sans drop-shadow-md">
          Implantação, integração e auditoria de sistemas de gestão ISO para construção, engenharia,
          indústria e logística, agora com uma camada de segurança da informação, privacidade de dados e
          governança de IA.
        </p>
      </Reveal>

      <Reveal delay={300} class="flex flex-col sm:flex-row gap-4">
        <Button
          href="/contato"
          size="lg"
          class="h-auto min-h-14 py-4 px-6 sm:px-8 text-sm sm:text-base rounded-full uppercase tracking-wider font-bold bg-primary hover:bg-primary/90 text-primary-foreground shadow-[0_4px_14px_0_rgba(207,174,112,0.39)] w-full sm:w-auto text-center whitespace-normal"
          linkClass="flex items-center justify-center"
        >
          Fale com um consultor <ArrowRight className="ml-2 h-5 w-5 shrink-0" />
        </Button>
        <Button
          href="/servicos"
          size="lg"
          variant="outline"
          class="h-auto min-h-14 py-4 px-6 sm:px-8 text-sm sm:text-base rounded-full uppercase tracking-wider font-bold border-white/25 bg-black/20 text-white hover:bg-white hover:text-black w-full sm:w-auto text-center whitespace-normal"
          linkClass="flex items-center justify-center"
        >
          Ver os serviços
        </Button>
      </Reveal>

      <Reveal delay={400}>
        <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-3 text-[11px] font-bold uppercase tracking-[0.22em]">
          <span class="text-primary">ISO 9001 · 14001 · 45001</span>
          <span class="hidden sm:block h-3 w-px bg-white/30" aria-hidden="true"></span>
          <span class="text-[#DCE4F0]">ISO/IEC 27001 · 42001 · LGPD</span>
          <a
            href="/tecnologia"
            class="inline-flex items-center gap-1.5 text-white border-b border-primary/60 pb-0.5 hover:text-primary transition-colors"
          >
            Camada tecnológica <ArrowRight className="h-3.5 w-3.5" />
          </a>
        </div>
      </Reveal>
    </div>
  </div>

  <div
    class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 animate-bounce motion-reduce:animate-none [@media(max-height:860px)]:hidden"
  >
    <ChevronDown className="h-8 w-8 text-primary opacity-80" />
  </div>
</section>
