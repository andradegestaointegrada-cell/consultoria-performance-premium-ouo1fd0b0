---
// Home: a camada tecnológica (catálogo da Cyber Consulting) sobre o núcleo de gestão da AGI.
import { ArrowRight, BrainCircuit, Fingerprint, LifeBuoy, ShieldCheck, Orbit, GraduationCap } from 'lucide-react'
import Reveal from '@/components/Reveal.astro'
import Button from '@/components/Button.astro'
import { FRENTES_TECH, GALAXIA, TRILHAS_EXIN } from '@/data/tecnologia'

const ICONES = [ShieldCheck, BrainCircuit, Fingerprint, LifeBuoy]
const totalExin = TRILHAS_EXIN.reduce((n, t) => n + t.itens.length, 0)
---

<section class="faixa-tech relative py-24 md:py-28 overflow-hidden" aria-labelledby="camada-tech-titulo">
  <div class="absolute inset-0 grade-tech"></div>
  <div class="container relative z-10 mx-auto px-4">
    <div class="grid lg:grid-cols-[1fr_1.15fr] gap-12 lg:gap-16 items-end">
      <Reveal>
        <span class="rotulo-tech text-primary">Camada tecnológica · com a Cyber Consulting</span>
        <h2
          id="camada-tech-titulo"
          class="mt-5 text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-white uppercase tracking-wide leading-tight"
        >
          A mesma estrutura de gestão, agora com segurança, privacidade e <em class="italic font-normal text-primary">IA</em>.
        </h2>
      </Reveal>
      <Reveal delay={100}>
        <p class="text-lg text-white/75 leading-relaxed">
          O SGI continua sendo a espinha. A Cyber Consulting conduz a parte técnica de segurança da informação, privacidade
          de dados e governança de IA, e a AGI integra tudo à mesma estrutura de cláusulas, com uma auditoria interna só.
        </p>
      </Reveal>
    </div>

    <div class="feixe-tech mt-14" aria-hidden="true"></div>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        FRENTES_TECH.map((f, i) => {
          const Icone = ICONES[i]
          return (
            <Reveal delay={i * 80}>
              <a
                href={`/tecnologia#${f.id}`}
                class="group relative flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-7 hover:border-primary/60 hover:bg-white/[0.05] transition-colors"
              >
                <div class="flex items-center justify-between">
                  <Icone className="h-8 w-8 text-primary" strokeWidth={1.5} />
                  <span class="text-[11px] font-bold tracking-[0.2em] text-white/60" aria-hidden="true">
                    {f.codigo}
                  </span>
                </div>
                <h3 class="mt-6 text-xl font-heading font-bold text-white uppercase tracking-wide group-hover:text-primary transition-colors">
                  {f.nome}
                </h3>
                <p class="mt-3 text-[11px] font-bold uppercase tracking-[0.16em] text-[#DCE4F0] leading-relaxed">
                  {f.normas.slice(0, 3).join(' · ')}
                </p>
              </a>
            </Reveal>
          )
        })
      }
    </div>

    <div class="mt-4 grid md:grid-cols-2 gap-4">
      <Reveal>
        <a
          href="/tecnologia#galaxia"
          class="group flex h-full items-center gap-5 rounded-2xl border border-white/10 bg-white/[0.03] p-6 hover:border-primary/60 transition-colors"
        >
          <Orbit className="h-8 w-8 shrink-0 text-primary" strokeWidth={1.5} />
          <span>
            <span class="block font-semibold text-white group-hover:text-primary transition-colors">
              Plataforma Galáxia: {GALAXIA.length} sistemas de GRC
            </span>
            <span class="block text-sm text-white/65">Contexto da empresa definido uma vez e compartilhado por todos.</span>
          </span>
        </a>
      </Reveal>
      <Reveal delay={80}>
        <a
          href="/tecnologia#educacao"
          class="group flex h-full items-center gap-5 rounded-2xl border border-white/10 bg-white/[0.03] p-6 hover:border-primary/60 transition-colors"
        >
          <GraduationCap className="h-8 w-8 shrink-0 text-primary" strokeWidth={1.5} />
          <span>
            <span class="block font-semibold text-white group-hover:text-primary transition-colors">
              {totalExin} certificações EXIN e cursos de normas
            </span>
            <span class="block text-sm text-white/65">Segurança da informação, privacidade e inteligência artificial.</span>
          </span>
        </a>
      </Reveal>
    </div>

    <Reveal class="mt-12">
      <Button
        href="/tecnologia"
        size="lg"
        class="h-auto min-h-14 py-4 px-8 rounded-full uppercase tracking-wider font-bold w-full sm:w-auto"
        linkClass="flex items-center justify-center"
      >
        Conhecer a camada tecnológica <ArrowRight className="ml-2 h-5 w-5" />
      </Button>
    </Reveal>
  </div>
</section>
