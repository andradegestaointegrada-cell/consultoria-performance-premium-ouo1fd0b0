---
import Reveal from '@/components/Reveal.astro'

const stats = [
  { value: '17+', label: 'Anos de Experiência' },
  { value: '10', label: 'Normas Atendidas' },
  { value: '22+', label: 'Clientes Atendidos' },
  { value: '100%', label: 'Certificados sem NC Maior' },
]
---

<section class="py-20 border-y border-border bg-background relative overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-secondary/50 via-background to-background pointer-events-none"
  >
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-border">
      {
        stats.map((stat, i) => (
          <Reveal delay={i * 100} class="text-center px-4">
            <div class="text-5xl md:text-7xl font-heading font-bold text-primary mb-2 drop-shadow-md">
              {stat.value}
            </div>
            <div class="text-sm md:text-base text-muted-foreground font-bold uppercase tracking-widest">
              {stat.label}
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
