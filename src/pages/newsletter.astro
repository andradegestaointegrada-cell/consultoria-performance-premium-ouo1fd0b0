---
// A confirmação da inscrição volta para /newsletter?status=...; a mensagem certa é
// mostrada por um script curto, já que a página é estática.
import BaseLayout from '@/layouts/BaseLayout.astro'
import Reveal from '@/components/Reveal.astro'
import { NewsletterSignup } from '@/components/NewsletterSignup'
import { mensagemWhatsApp } from '@/data/site'

const RETORNOS: Record<string, { titulo: string; texto: string }> = {
  confirmada: {
    titulo: 'Inscrição confirmada',
    texto: 'Você vai receber a próxima edição no seu e-mail. Todo envio traz o link para cancelar.',
  },
  expirado: {
    titulo: 'Link expirado',
    texto: 'O link de confirmação vale por 7 dias. Faça a inscrição de novo abaixo.',
  },
  invalido: {
    titulo: 'Link inválido',
    texto: 'Não reconhecemos este link de confirmação. Faça a inscrição de novo abaixo.',
  },
  erro: {
    titulo: 'Não foi possível confirmar agora',
    texto: 'Tente o link do e-mail mais tarde ou faça a inscrição de novo abaixo.',
  },
}
---

<BaseLayout
  title="Newsletter | Andrade Gestão Integrada"
  description="Newsletter quinzenal da AGI sobre sistemas de gestão, normas ISO e NRs: o que muda, como isso afeta a operação e o que fazer primeiro. Cancelamento em um clique."
  breadcrumbs={[{ name: 'Newsletter', path: '/newsletter' }]}
  whatsapp={mensagemWhatsApp('Newsletter')}
>
  <div class="pt-32 pb-24 bg-background min-h-screen">
    <div class="container mx-auto px-4 max-w-2xl">
      <Reveal>
        {
          Object.entries(RETORNOS).map(([status, r]) => (
            <div
              class="mb-12 rounded-xl border-2 border-primary bg-card p-6 md:p-8"
              role="status"
              data-retorno={status}
              hidden
            >
              <h2 class="text-2xl font-heading font-bold text-foreground uppercase tracking-wide mb-2">{r.titulo}</h2>
              <p class="text-muted-foreground">{r.texto}</p>
              {status === 'confirmada' && (
                <a
                  href="/insights"
                  class="inline-block mt-4 text-primary font-bold uppercase tracking-wider text-sm hover:underline"
                >
                  Enquanto isso, leia o blog →
                </a>
              )}
            </div>
          ))
        }

        <div id="newsletter-inscricao">
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-foreground mb-6 uppercase tracking-wide">
            Newsletter da AGI
          </h1>
          <p class="text-lg text-muted-foreground mb-4">
            A cada quinze dias, um tema de sistemas de gestão explicado para quem decide: o que muda
            nas normas ISO e nas NRs, como isso afeta a operação e o que fazer primeiro.
          </p>
          <p class="text-muted-foreground mb-10">
            Sem propaganda disfarçada. Cancelamento em um clique, em qualquer envio.
          </p>
          <NewsletterSignup client:idle origem="pagina-newsletter" id="pagina-newsletter" />
        </div>
      </Reveal>
    </div>
  </div>

  <script is:inline>
    ;(function () {
      var status = new URLSearchParams(location.search).get('status')
      var aviso = null
      document.querySelectorAll('[data-retorno]').forEach(function (el) {
        if (el.getAttribute('data-retorno') === status) aviso = el
      })
      if (!aviso) return
      aviso.hidden = false
      if (status === 'confirmada') document.getElementById('newsletter-inscricao').hidden = true
    })()
  </script>
</BaseLayout>
