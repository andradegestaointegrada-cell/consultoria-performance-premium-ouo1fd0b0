---
import { Image } from 'astro:assets'
import { Linkedin } from 'lucide-react'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { fundoHero } from '@/lib/fundo'
import Reveal from '@/components/Reveal.astro'
import { mensagemWhatsApp, ORG_ID, SITE_URL } from '@/data/site'
import sobreHero from '@/assets/sobre/sobre-hero.webp'
import flexibilidade from '@/assets/sobre/flexibilidade.webp'
import fotoAlexandre from '@/assets/sobre/alexandre-andrade.webp'
import fotoThatiana from '@/assets/sobre/thatiana-pidlepa-andrade.webp'

const team = [
  {
    name: 'Alexandre Andrade',
    alt: 'Consultor Alexandre Andrade',
    role: 'Diretor e Consultor Principal',
    img: fotoAlexandre,
    linkedin: 'https://www.linkedin.com/in/alexandreandradegestaodeprojetos',
  },
  {
    name: 'Thatiana Pidlepa Andrade',
    alt: 'Auditora Thatiana Pidlepa Andrade',
    role: 'Auditora',
    img: fotoThatiana,
  },
]

const destaques = [
  'Amplo Domínio: ISO 9001, 14001, 45001, 17020, 17025, IATF 16949, PBQP-H, SASSMAQ',
  'Ajuste de Processos com Foco na Realidade do Cliente',
  'Gestão Completa ou Suporte Colaborativo',
  'Melhoria Contínua e Acompanhamento Ágil',
]

const pessoas = [
  {
    '@type': 'Person',
    '@id': `${SITE_URL}/sobre#thatiana-pidlepa-andrade`,
    name: 'Thatiana Pidlepa Andrade',
    jobTitle: 'Auditora',
    worksFor: { '@id': ORG_ID },
  },
]
const fundo = await fundoHero(sobreHero)
---

<BaseLayout
  title="Sobre | Andrade Gestão Integrada"
  description="Conheça a Andrade Gestão Integrada (AGI): consultoria em sistemas de gestão ISO com gestão completa ou suporte colaborativo, e o time de consultoria e auditoria."
  image={sobreHero}
  pageType="AboutPage"
  breadcrumbs={[{ name: 'Sobre', path: '/sobre' }]}
  jsonLd={pessoas}
  whatsapp={mensagemWhatsApp('Sobre')}
  preloadImage={fundo}
>
  <div class="pt-20">
    <section
      class="py-32 relative bg-fixed bg-cover bg-center border-b border-border"
      style={`background-image: url('${fundo}')`}
    >
      <div class="absolute inset-0 bg-[#0D0D0D]/85"></div>
      <div class="container relative z-10 mx-auto px-4 text-center max-w-4xl">
        <Reveal>
          <h1
            class="text-3xl sm:text-4xl md:text-6xl font-heading font-bold text-white mb-6 uppercase tracking-wide drop-shadow-lg break-words"
          >
            Andrade{' '}
            <em class="font-heading italic font-normal text-primary">Gestão Integrada</em>
          </h1>
          <p class="text-lg sm:text-xl text-white/90 leading-relaxed font-sans drop-shadow-md">
            Especialistas em sistemas de gestão com foco absoluto em resultados. Nossa consultoria se
            destaca pela flexibilidade operacional, adaptando-se integralmente à dinâmica e aos prazos
            da sua empresa, oferecendo desde o gerenciamento completo até o suporte técnico
            colaborativo.
          </p>
        </Reveal>
      </div>
    </section>

    <section class="py-24">
      <div class="container mx-auto px-4">
        <Reveal>
          <div
            class="max-w-4xl mx-auto bg-primary/5 border-l-4 border-primary p-8 md:p-12 mb-24 rounded-r-2xl shadow-sm"
          >
            <h2
              class="text-xl md:text-3xl font-heading font-bold text-foreground leading-relaxed uppercase tracking-wide text-center"
            >
              "Diagnóstico, implementação e evolução de sistemas de gestão orientados à{' '}
              <em class="font-heading italic text-primary font-normal">estratégia</em> e à{' '}
              <em class="font-heading italic text-primary font-normal">performance</em>."
            </h2>
          </div>
        </Reveal>

        <div class="grid md:grid-cols-2 gap-16 items-center mb-24">
          <Reveal class="order-2 md:order-1">
            <div class="relative">
              <div
                class="absolute -inset-1 bg-gradient-to-tr from-primary/50 to-transparent rounded-2xl blur-lg opacity-30"
              >
              </div>
              <Image
                src={flexibilidade}
                alt="Flexibilidade e Adaptação"
                widths={[640, 960, 1279]}
                sizes="(min-width: 768px) 50vw, 100vw"
                class="relative w-full aspect-[4/3] object-cover rounded-2xl border-2 border-border shadow-2xl grayscale hover:grayscale-0 transition-all duration-700"
              />
            </div>
          </Reveal>
          <Reveal class="order-1 md:order-2" delay={100}>
            <h2 class="text-3xl md:text-4xl font-heading font-bold text-foreground mb-4 uppercase tracking-wide">
              Flexibilidade e Adaptação
            </h2>
            <p class="text-muted-foreground text-lg mb-6 font-sans">
              Entendemos que cada organização possui seu próprio ritmo. Nosso diferencial é a
              flexibilidade operacional: atuamos conforme as suas necessidades, seja assumindo a
              gestão completa dos sistemas ou atuando de forma colaborativa com a sua equipe técnica.
            </p>
            <ul class="space-y-4 font-sans">
              {
                destaques.map((item) => (
                  <li class="flex items-center text-foreground font-medium">
                    <span class="h-2 w-2 rounded-full bg-primary mr-3 shadow-[0_0_8px_rgba(207,174,112,0.8)] min-w-[8px]" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </Reveal>
        </div>
      </div>
    </section>

    <section class="py-24 bg-card border-t border-border">
      <div class="container mx-auto px-4">
        <Reveal>
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-5xl font-heading font-bold text-foreground mb-4 uppercase tracking-wide">
              Nosso Time
            </h2>
            <p class="text-muted-foreground font-sans">
              Especialistas com vivência técnica e foco em resultados operacionais.
            </p>
          </div>
        </Reveal>
        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {
            team.map((member, i) => (
              <Reveal delay={i * 100}>
                <div class="bg-background border-2 border-border rounded-xl p-6 text-center group hover:border-primary transition-colors duration-300">
                  <div class="w-32 h-32 mx-auto rounded-full overflow-hidden border-2 border-border mb-6 group-hover:border-primary transition-colors duration-300">
                    <Image
                      src={member.img}
                      alt={member.alt}
                      width={384}
                      class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 object-top"
                    />
                  </div>
                  <h3 class="text-2xl font-heading font-bold text-foreground mb-1 uppercase tracking-wide">
                    {member.name}
                  </h3>
                  <p class="text-primary text-sm font-bold uppercase tracking-wider font-sans">{member.role}</p>
                  {member.linkedin && (
                    <div class="mt-5 flex justify-center">
                      <a
                        href={member.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center p-2 rounded-full bg-primary/10 text-primary hover:bg-primary hover:text-primary-foreground transition-colors duration-300"
                        title={`LinkedIn - ${member.name}`}
                        aria-label={`LinkedIn - ${member.name}`}
                      >
                        <Linkedin className="w-5 h-5" />
                      </a>
                    </div>
                  )}
                </div>
              </Reveal>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
