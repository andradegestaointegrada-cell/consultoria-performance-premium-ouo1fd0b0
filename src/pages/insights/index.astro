---
import { Image } from 'astro:assets'
import { ArrowRight } from 'lucide-react'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { fundoHero } from '@/lib/fundo'
import Reveal from '@/components/Reveal.astro'
import { listarArtigos } from '@/lib/artigos'
import { cn } from '@/lib/utils'
import { mensagemWhatsApp, ORG_ID, SITE_URL } from '@/data/site'
import blogHero from '@/assets/blog/blog-hero.webp'

const articles = await listarArtigos()
const highlighted = articles.filter((a) => a.data.is_highlighted)
const featured = highlighted[0] ?? articles[0] ?? null
const rest = articles
  .filter((a) => a.id !== featured?.id)
  .sort((a, b) => Number(b.data.is_highlighted) - Number(a.data.is_highlighted))

const blog = {
  '@type': 'Blog',
  '@id': `${SITE_URL}/insights#blog`,
  name: 'Blog Técnico da AGI',
  url: `${SITE_URL}/insights`,
  inLanguage: 'pt-BR',
  publisher: { '@id': ORG_ID },
  blogPost: articles.map((a) => ({
    '@type': 'BlogPosting',
    headline: a.data.title,
    url: `${SITE_URL}/insights/${a.id}`,
    datePublished: a.data.published_date.toISOString(),
  })),
}
const fundo = await fundoHero(blogHero)
---

<BaseLayout
  title="Blog | Andrade Gestão Integrada"
  description="Artigos técnicos sobre sistemas de gestão, normas ISO, NR-01, ESG, ISO/IEC 42001 e ISO 37001, escritos pela equipe da Andrade Gestão Integrada."
  image={blogHero}
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Blog', path: '/insights' }]}
  jsonLd={[blog]}
  whatsapp={mensagemWhatsApp('Blog')}
  preloadImage={fundo}
>
  <div class="pt-20 min-h-screen bg-background">
    <section
      class="py-32 relative bg-fixed bg-cover bg-center border-b border-border"
      style={`background-image: url('${fundo}')`}
    >
      <div class="absolute inset-0 bg-[#0D0D0D]/85"></div>
      <div class="container relative z-10 mx-auto px-4 text-center">
        <Reveal>
          <h1
            class="text-3xl sm:text-4xl md:text-6xl font-heading font-bold text-white mb-6 uppercase tracking-wide drop-shadow-lg break-words"
          >
            Blog Técnico & Inteligência
          </h1>
          <p class="text-lg sm:text-xl text-white/90 max-w-2xl mx-auto drop-shadow-md font-sans">
            Artigos, análises e tendências sobre alta performance empresarial e certificações
            internacionais.
          </p>
        </Reveal>
      </div>
    </section>

    <section class="py-24">
      <div class="container mx-auto px-4">
        {
          featured && (
            <Reveal>
              <div class="mb-20">
                <h2 class="text-2xl font-heading font-bold text-foreground mb-8 border-b border-border pb-4 uppercase tracking-wide">
                  {featured.data.is_highlighted ? 'Em Destaque' : 'Último Artigo'}
                </h2>
                <a
                  href={`/insights/${featured.id}`}
                  class={cn(
                    'relative rounded-2xl overflow-hidden flex flex-col justify-end min-h-[450px] md:min-h-[500px] border-2 transition-all duration-500 group block',
                    featured.data.is_highlighted
                      ? 'border-primary ring-2 ring-primary/40 shadow-lg shadow-primary/20'
                      : 'border-border hover:border-primary',
                  )}
                >
                  <Image
                    src={featured.data.image}
                    alt={featured.data.imageAlt ?? featured.data.title}
                    widths={[640, 960, 1280, 1536]}
                    sizes="(min-width: 1320px) 1256px, 100vw"
                    class="absolute inset-0 w-full h-full object-cover object-center transition-all duration-500 grayscale group-hover:grayscale-0 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-300" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/70 to-transparent pointer-events-none" />
                  <div class="relative z-10 p-6 md:p-10 max-w-4xl">
                    <div class="text-primary font-bold text-xs md:text-sm uppercase tracking-widest mb-3 font-sans flex items-center gap-3">
                      {featured.data.is_highlighted && (
                        <span class="bg-primary text-primary-foreground px-2.5 py-0.5 rounded-sm shadow-sm">
                          Destaque Especial
                        </span>
                      )}
                      <span>{featured.data.category || 'Estratégia'}</span>
                    </div>
                    <h3 class="text-2xl sm:text-3xl md:text-5xl font-heading font-bold text-white mb-4 group-hover:text-primary transition-colors uppercase tracking-wide leading-tight">
                      {featured.data.title}
                    </h3>
                    <p class="text-white/80 text-sm md:text-lg line-clamp-3 md:line-clamp-2 font-sans mb-6">
                      {featured.data.summary}
                    </p>
                    <span class="inline-flex items-center text-primary font-bold uppercase tracking-wider text-sm group-hover:text-white transition-colors">
                      Ler Artigo Completo <ArrowRight className="ml-2 h-4 w-4" />
                    </span>
                  </div>
                </a>
              </div>
            </Reveal>
          )
        }

        {
          rest.length > 0 && (
            <>
              <h2 class="text-2xl font-heading font-bold text-foreground mb-8 border-b border-border pb-4 uppercase tracking-wide">
                Outros Artigos
              </h2>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {rest.map((article, i) => (
                  <Reveal delay={i * 100}>
                    <a
                      href={`/insights/${article.id}`}
                      class={cn(
                        'group h-full bg-card rounded-xl overflow-hidden border-2 transition-all duration-300 flex flex-col block relative',
                        article.data.is_highlighted
                          ? 'border-primary ring-1 ring-primary/40 shadow-md'
                          : 'border-border hover:border-primary',
                      )}
                    >
                      <div class="aspect-video overflow-hidden relative">
                        <Image
                          src={article.data.image}
                          alt={article.data.imageAlt ?? article.data.title}
                          widths={[400, 640, 960]}
                          sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                          class="absolute inset-0 w-full h-full object-cover object-center transition-all duration-500 grayscale group-hover:grayscale-0 group-hover:scale-105"
                        />
                        <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-300" />
                      </div>
                      <div class="p-6 flex-grow flex flex-col">
                        <div class="text-primary text-xs font-bold uppercase tracking-widest mb-3 font-sans flex items-center gap-2">
                          {article.data.is_highlighted && (
                            <span class="bg-primary text-primary-foreground px-2 py-0.5 rounded-sm">Destaque</span>
                          )}
                          <span>{article.data.category || 'Insights'}</span>
                        </div>
                        <h3 class="text-xl font-heading font-bold text-foreground group-hover:text-primary transition-colors uppercase tracking-wide leading-tight mb-4">
                          {article.data.title}
                        </h3>
                        <p class="text-muted-foreground text-sm line-clamp-3 mb-6 flex-grow">{article.data.summary}</p>
                        <span class="inline-flex items-center text-primary font-bold uppercase tracking-wider text-sm mt-auto">
                          Ler Mais <ArrowRight className="ml-2 h-4 w-4" />
                        </span>
                      </div>
                    </a>
                  </Reveal>
                ))}
              </div>
            </>
          )
        }

        {!featured && <div class="text-center py-20 text-muted-foreground">Nenhum artigo publicado ainda.</div>}
      </div>
    </section>
  </div>
</BaseLayout>
