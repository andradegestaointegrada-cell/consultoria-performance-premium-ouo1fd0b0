---
// Vira dist/404.html: a Cloudflare Pages devolve esta página com status 404 real
// para qualquer endereço que não exista.
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
---

<BaseLayout
  title="Página não encontrada | Andrade Gestão Integrada"
  description="O endereço pode ter mudado ou não existir mais. Veja os serviços, o blog ou fale com a AGI."
  noindex
>
  <div class="pt-40 pb-32 bg-background min-h-[70vh]">
    <div class="container mx-auto px-4 max-w-2xl text-center">
      <p class="text-primary font-bold uppercase tracking-widest text-sm mb-4">Erro 404</p>
      <h1 class="text-3xl md:text-5xl font-heading font-bold text-foreground uppercase tracking-wide mb-6">
        Página não encontrada
      </h1>
      <p class="text-muted-foreground text-lg mb-10">O endereço pode ter mudado ou não existir mais.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/" size="lg" class="uppercase font-bold tracking-wider">Ir para a página inicial</Button>
        <Button href="/insights" size="lg" variant="outline" class="uppercase font-bold tracking-wider">
          Ver o blog
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
