---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { fundoHero } from '@/lib/fundo'
import Reveal from '@/components/Reveal.astro'
import Card from '@/components/Card.astro'
import { SERVICOS_LISTA } from '@/data/services'
import { FRENTES_TECH } from '@/data/tecnologia'
import { mensagemWhatsApp, ORG_ID, SITE_URL } from '@/data/site'
import servicosHero from '@/assets/servicos/servicos-hero.webp'

const lista = {
  '@type': 'ItemList',
  '@id': `${SITE_URL}/servicos#lista`,
  name: 'Serviços da Andrade Gestão Integrada',
  itemListElement: SERVICOS_LISTA.map((svc, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE_URL}/servicos/${svc.id}`,
    name: `${svc.title} · ${svc.name}`,
  })),
  provider: { '@id': ORG_ID },
}
const fundo = await fundoHero(servicosHero)
---

<BaseLayout
  title="Serviços e normas | Andrade Gestão Integrada"
  description="Consultoria em ISO 9001, 14001, 45001, SGI, PBQP-H, IATF 16949, ISO/IEC 17020, 17025, SASSMAQ, ESG, ISO/IEC 42001 e ISO 37001: implantação, integração, auditoria interna e manutenção do sistema."
  image={servicosHero}
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Serviços', path: '/servicos' }]}
  jsonLd={[lista]}
  whatsapp={mensagemWhatsApp('Serviços')}
  preloadImage={fundo}
>
  <div class="pt-20">
    <section
      class="py-32 relative bg-fixed bg-cover bg-center border-b border-border"
      style={`background-image: url('${fundo}')`}
    >
      <div class="absolute inset-0 bg-[#0D0D0D]/85"></div>
      <div class="absolute inset-0 grade-tech [mask-image:radial-gradient(ellipse_70%_80%_at_50%_50%,#000_10%,transparent_75%)]"></div>
      <div class="container relative z-10 mx-auto px-4 text-center max-w-3xl">
        <Reveal>
          <h1
            class="text-3xl sm:text-4xl md:text-6xl font-heading font-bold text-white mb-6 uppercase tracking-wide drop-shadow-lg break-words"
          >
            Especialidades e{' '}
            <em class="font-heading italic font-normal text-primary">Certificações</em>
          </h1>
          <p class="text-lg sm:text-xl text-white/90 drop-shadow-md font-sans">
            Com flexibilidade operacional, adaptamos nossas soluções em sistemas de gestão para
            oferecer desde suporte técnico colaborativo até o gerenciamento completo.
          </p>
        </Reveal>
      </div>
    </section>

    <section class="py-24 bg-background">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            SERVICOS_LISTA.map((svc, i) => (
              <Reveal delay={i * 40} class="h-full">
                <a href={`/servicos/${svc.id}`} class="block h-full group">
                  <Card class="h-full bg-card hover:bg-card/95 border-2 border-border hover:border-primary hover:shadow-[0_0_28px_rgba(207,174,112,0.14)] transition-all duration-300 relative overflow-hidden flex flex-col">
                    <div class="relative aspect-[16/10] overflow-hidden bg-secondary">
                      <Image
                        src={svc.img}
                        alt={`${svc.title} — ${svc.name}`}
                        widths={[360, 560, 720].filter((w) => w <= svc.img.width)}
                        sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                        class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105 opacity-90 lg:opacity-75 group-hover:opacity-100 lg:grayscale lg:group-hover:grayscale-0"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-card via-card/25 to-transparent" />
                      <span class="absolute top-3 left-3 z-10 inline-flex items-center rounded-md border border-primary/50 bg-[#0D0D0D]/85 backdrop-blur-sm px-2.5 py-1 text-xs font-bold tracking-widest uppercase text-primary shadow-md">
                        {svc.title}
                      </span>
                    </div>
                    <Card content class="p-6 pt-5 relative z-10 flex flex-col flex-grow">
                      <h2 class="text-xl xl:text-2xl font-heading font-bold text-foreground mb-3 group-hover:text-primary transition-colors uppercase tracking-wide leading-snug">
                        {svc.name}
                      </h2>
                      <p class="text-muted-foreground text-sm flex-grow font-sans leading-relaxed">{svc.desc}</p>
                      <div class="mt-6 pt-4 border-t border-border/50 flex items-center justify-between text-xs font-bold text-foreground group-hover:text-primary transition-colors uppercase tracking-wider font-sans">
                        <span>Ver Mais</span>
                        <span class="group-hover:translate-x-1.5 transition-transform text-primary">→</span>
                      </div>
                    </Card>
                  </Card>
                </a>
              </Reveal>
            ))
          }
        </div>
      </div>
    </section>

    <section class="faixa-tech relative py-20 overflow-hidden">
      <div class="absolute inset-0 grade-tech"></div>
      <div class="container relative z-10 mx-auto px-4">
        <Reveal class="grid lg:grid-cols-[1.2fr_1fr] gap-10 items-center">
          <div>
            <span class="rotulo-tech text-primary">Camada tecnológica · com a Cyber Consulting</span>
            <h2 class="mt-5 text-3xl md:text-4xl font-heading font-bold text-white uppercase tracking-wide leading-tight">
              Segurança da informação, privacidade e IA no mesmo SGI.
            </h2>
            <p class="mt-5 text-lg text-white/75 leading-relaxed">
              ISO/IEC 27001, LGPD e ISO/IEC 27701, ISO/IEC 42001, ISO 31000 e ISO 22301, mais a plataforma Galáxia e as
              certificações EXIN, integradas ao sistema de gestão.
            </p>
          </div>
          <ul class="grid grid-cols-2 gap-3">
            {
              FRENTES_TECH.map((f) => (
                <li>
                  <a
                    href={`/tecnologia#${f.id}`}
                    class="flex h-full flex-col rounded-xl border border-white/10 bg-white/[0.03] p-5 hover:border-primary/60 transition-colors group"
                  >
                    <span class="text-[11px] font-bold tracking-[0.2em] text-white/60">{f.codigo}</span>
                    <span class="mt-2 font-semibold text-white group-hover:text-primary transition-colors">{f.nome}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </Reveal>
      </div>
    </section>
  </div>
</BaseLayout>
