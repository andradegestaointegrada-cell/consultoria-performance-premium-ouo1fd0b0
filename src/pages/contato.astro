---
import { Image } from 'astro:assets'
import { MapPin, Phone, Mail } from 'lucide-react'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { fundoHero } from '@/lib/fundo'
import Reveal from '@/components/Reveal.astro'
import { ContactForm } from '@/components/ContactForm'
import { EMAIL_CONTATO, WHATSAPP, WHATSAPP_URL } from '@/lib/api'
import { mensagemWhatsApp } from '@/data/site'
import contatoHero from '@/assets/contato/contato-hero.webp'
import matriz from '@/assets/contato/matriz-agi.webp'

const [usuarioEmail, dominioEmail] = EMAIL_CONTATO.split('@')
const fundo = await fundoHero(contatoHero)
---

<BaseLayout
  title="Contato | Andrade Gestão Integrada"
  description="Fale com a Andrade Gestão Integrada: formulário, WhatsApp +55 (11) 98613-4789 e e-mail. Rua Pais Leme, 215, conj. 1713, Pinheiros, São Paulo/SP."
  image={contatoHero}
  pageType="ContactPage"
  breadcrumbs={[{ name: 'Contato', path: '/contato' }]}
  whatsapp={mensagemWhatsApp('Contato')}
  preloadImage={fundo}
>
  <div class="pt-20">
    <section
      class="py-32 relative bg-fixed bg-cover bg-center border-b border-border text-center"
      style={`background-image: url('${fundo}')`}
    >
      <div class="absolute inset-0 bg-[#091D39]/85"></div>
      <div class="container relative z-10 mx-auto px-4 max-w-4xl">
        <Reveal>
          <h1
            class="text-3xl sm:text-4xl md:text-6xl font-heading font-bold mb-6 uppercase tracking-wide text-white drop-shadow-lg break-words"
          >
            Inicie a{' '}
            <b class="text-primary font-extrabold italic font-heading">TRANSFORMAÇÃO</b>
          </h1>
          <p class="text-lg sm:text-xl text-white/90 leading-relaxed font-sans drop-shadow-md">
            Fale com nossos especialistas para elevar a performance da sua empresa.
          </p>
        </Reveal>
      </div>
    </section>

    <section class="py-24 relative bg-background">
      <div class="container relative z-10 px-4 max-w-6xl grid md:grid-cols-2 gap-16">
        <Reveal>
          <div
            class="bg-card p-8 rounded-2xl border border-border shadow-xl hover:border-primary/50 transition-colors duration-500"
          >
            <h2 class="text-2xl font-heading font-bold uppercase tracking-wide mb-6 text-foreground">
              Envie uma mensagem
            </h2>
            <ContactForm client:idle />
          </div>
        </Reveal>

        <Reveal delay={200} class="space-y-12">
          <div class="bg-card p-8 rounded-2xl border border-border shadow-lg">
            <h2
              class="text-2xl font-heading font-bold mb-8 border-b border-border pb-4 uppercase tracking-wide text-foreground"
            >
              Contato Andrade Gestão Integrada
            </h2>
            <div class="space-y-8">
              <div class="flex items-start gap-4">
                <div class="p-3 rounded-full bg-secondary border border-border">
                  <MapPin className="text-primary" />
                </div>
                <div class="pt-1">
                  <p class="font-bold text-foreground uppercase tracking-wide font-sans">Sede Operacional</p>
                  <address class="not-italic text-sm text-muted-foreground mt-1 font-sans leading-relaxed">
                    Rua Pais Leme, 215, conj. 1713
                    <br />
                    Pinheiros, São Paulo/SP · CEP 05424-150
                  </address>
                </div>
              </div>
              <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 group">
                <div
                  class="p-3 rounded-full bg-secondary border border-border group-hover:border-primary transition-colors duration-300"
                >
                  <Phone className="text-primary group-hover:drop-shadow-[0_0_8px_rgba(207,174,112,0.8)] transition-all" />
                </div>
                <p
                  class="font-bold text-foreground text-lg group-hover:text-primary transition-colors duration-300 font-sans"
                >
                  {WHATSAPP}
                </p>
              </a>
              <a href={`mailto:${EMAIL_CONTATO}`} class="flex items-center gap-4 group">
                <div
                  class="p-3 rounded-full bg-secondary border border-border group-hover:border-primary transition-colors duration-300"
                >
                  <Mail className="text-primary group-hover:drop-shadow-[0_0_8px_rgba(207,174,112,0.8)] transition-all" />
                </div>
                <p
                  class="font-bold text-foreground text-sm [overflow-wrap:anywhere] group-hover:text-primary transition-colors duration-300 font-sans"
                >
                  {usuarioEmail}@<wbr />{dominioEmail}
                </p>
              </a>
            </div>
          </div>

          <div class="h-64 rounded-2xl overflow-hidden border border-border bg-card relative shadow-lg group">
            <Image
              src={matriz}
              alt="Fachada do edifício da Rua Pais Leme, 215, sede da AGI"
              widths={[400, 560, 840]}
              sizes="(min-width: 768px) 560px, calc(100vw - 32px)"
              fetchpriority="low"
              class="w-full h-full object-cover object-center opacity-90 transition-all duration-700 group-hover:scale-105 group-hover:opacity-100"
            />
          </div>
        </Reveal>
      </div>
    </section>
  </div>
</BaseLayout>
